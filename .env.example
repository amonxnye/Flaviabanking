#NEXT
NEXT_PUBLIC_SITE_URL=http://localhost:3000

#FIREBASE — client web config (public identifiers, safe in the browser).
# Firebase console → Project settings → Your apps → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server side (firebase-admin). Leave EMPTY on Firebase App Hosting — the backend's
# service account is used automatically. For local dev paste the service-account JSON
# (Project settings → Service accounts → Generate new private key), raw or base64.
FIREBASE_SERVICE_ACCOUNT=

#PLAID
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
PLAID_PRODUCTS=
PLAID_COUNTRY_CODES=

#DWOLLA
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_BASE_URL=
DWOLLA_ENV=

#SECURITY
# REQUIRED in production. Used to HMAC-sign shareable account IDs.
# Generate a strong value, e.g.:  openssl rand -hex 32
# The app refuses to sign IDs in production without a unique value.
ID_SIGNING_SECRET=

#IOTEC PAY (mobile money collections)
# From your ioTec Pay account. Keep the secret confidential — never commit it.
IOTEC_CLIENT_ID=
IOTEC_CLIENT_SECRET=
# Live wallet id (or the test wallet id while integrating).
IOTEC_WALLET_ID=
# Shared secret used to gate the webhook. Generate: openssl rand -hex 24
# Configure ioTec callback URL as: https://<domain>/api/iotec/webhook?secret=<value>
IOTEC_WEBHOOK_SECRET=
# Optional overrides (defaults shown):
# IOTEC_AUTH_URL=https://id.iotec.io/connect/token
# IOTEC_BASE_URL=https://pay.iotec.io
# IOTEC_COLLECT_PATH=/api/collections/collect
# IOTEC_STATUS_PATH=/api/collections/{id}

#SENTRY (optional). Use your OWN project's DSN; leave empty to disable error reporting.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for source-map upload during `next build`:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

#AGENTSTUDIO (AI assistant)
# Backend-only. Never expose the API key to the browser.
STUDIO_URL=https://agentstudio--ridelinkx.us-east4.hosted.app
STUDIO_API_KEY=
STUDIO_AGENT_ID=
# One signing secret per registered tool (returned once at registration):
STUDIO_SECRET_GET_WALLET_BALANCE=
STUDIO_SECRET_LIST_RECENT_COLLECTIONS=
STUDIO_SECRET_GET_LINKED_ACCOUNTS=
