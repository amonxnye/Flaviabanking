rules_version = '2';

// All reads and writes go through the server (Firebase Admin SDK in Next.js
// server actions), which checks the session cookie and scopes queries to the
// signed-in user. Browsers never talk to Firestore directly, so deny everything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
